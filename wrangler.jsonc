{
  "name": "stayflow-local",
  "main": "server/index.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:8787"
  }
}
