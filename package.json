{
  "name": "stayflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.22.3"
  },
  "scripts": {
    "build": "vite build && wrangler deploy --dry-run --outdir work/worker-build",
    "dev": "vite build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src server shared tests/unit tests/e2e tests/db",
    "test": "vitest run",
    "test:db": "node --test tests/db/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.66.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.164.0"
  }
}
